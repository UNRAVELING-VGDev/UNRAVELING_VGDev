# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/

# Unity cache
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE / editor files
.vscode/
.idea/
.vs/

# OS files
.DS_Store

# Visual Studio
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs

# Unity crash reports
sysinfo.txt
Library/
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/

# Never ignore DLLs in the FMOD subfolder.
!/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# If the source bank files are kept outside of the StreamingAssets folder then these can be ignored.
# Log files can be ignored.
fmod_editor.log

# FMOD Studio local cache, user settings, and recovery files.
/FMOD/unraveling fmod master/.cache/
/FMOD/unraveling fmod master/.user/
/FMOD/unraveling fmod master/.unsaved/
/FMOD/unraveling fmod master/.restore/
/FMOD/unraveling fmod master/.recycle/
/FMOD/unraveling fmod master/.user.vc/

# FMOD profiler recordings. Keep all other project Metadata and source Assets.
/FMOD/unraveling master/Metadata/ProfilerSession/
# Generated banks are already excluded by the Build/ rule above.
